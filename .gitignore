# Local settings
.claude/

# Generated spec artifacts from local dogfooding — ROOT-ANCHORED on purpose.
# Unanchored patterns (**/SPEC.md etc.) match case-insensitively on Windows
# and silently swallowed plugin SOURCE (plugins/kana-spec/commands/spec.md,
# caught in PR #35 review). Never widen these back to **/ patterns.
/SPEC.md
/prompt.md
/SPEC/
/spec/
/specs/
/dev/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# Node modules (if any scripts added later)
node_modules/

# Logs
*.log

# Git worktrees
.worktrees/

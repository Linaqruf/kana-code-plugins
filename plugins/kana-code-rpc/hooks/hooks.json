{
  "description": "Discord Rich Presence for Claude Code. Session lifecycle only: the daemon reads the current tool from the session transcript, so no hook runs per tool call.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/presence.py\" start",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/presence.py\" update",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/presence.py\" stop",
            "async": true
          }
        ]
      }
    ]
  }
}
